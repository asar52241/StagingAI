# OpenAI (обработка фото)
OPENAI_API_KEY=your_openai_api_key_here

# Robokassa (боевые реквизиты)
ROBOKASSA_LOGIN=your_robokassa_login
ROBOKASSA_PASSWORD1=your_robokassa_password1
ROBOKASSA_PASSWORD2=your_robokassa_password2

# Robokassa (тестовый режим)
ROBOKASSA_TEST=false
ROBOKASSA_TEST_PASSWORD1=your_robokassa_test_password1
ROBOKASSA_TEST_PASSWORD2=your_robokassa_test_password2

# Upstash Redis (учёт квоты заказов + rate-limit) — REST API, https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Сайт
NEXT_PUBLIC_SITE_URL=https://staging-ai.ru
