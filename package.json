{
  "name": "ai-declutter",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "db:setup": "node scripts/db-setup.mjs",
